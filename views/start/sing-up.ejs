<!DOCTYPE html>
<head>

    
<section id="titel" class="gradient-background" style="position: relative;">
    <div style="display:flex; align-items: center;">
        <img src="img/t4-1-128.png
        " alt="icon-square" width="50px" height="55px">
        <h1 style=" margin-left: 10px;">T4Student<br></h1>   
    </div>  

    
</section>
</head>

<section class="form-signin w-100 m-auto">
    <div class="col-md-7 col-lg-8">
        <h4 class="mb-3" style="text-align: center;font-size: 40px;">Sing up</h4>
        <% if (locals.validpas) { %>
          <p style="color: red; text-align: center;">
            <%= validpas %>
          </p>
          <% }%>
        <form class="needs-validation" novalidate="" action="\sing-up" method="post">
          <div class="row g-3">
            <div class="col-sm-6">
              <label for="firstName" class="form-label">First name</label>
              <input type="text" class="form-control" id="fname" name="fname" placeholder="" value="" required="">
              <div class="invalid-feedback">
                Valid first name is required.
              </div>
            </div>

            <div class="col-sm-6">
              <label for="lastName" class="form-label">Last name</label>
              <input type="text" class="form-control" id="lname" name="lname" placeholder="" value="" required="">
              <div class="invalid-feedback">
                Valid last name is required.
              </div>
            </div>


            <div class="col-12">
              <label for="email" class="form-label">Email <span class="text-body-secondary">(Optional)</span></label>
              <input type="email" class="form-control" id="email" name="email" placeholder="T4Student@gamil.com">
              <div class="invalid-feedback">
                Please enter a valid email address for shipping updates.
              </div>
            </div>
 
            <hr class="my-4">

            <div class="form-check radios">
              <input type="radio" class="form-check-input" id="studentRole" name="user" value="student" checked>
              <label class="form-check-label" for="studentRole" >Student</label>
            </div>
            
            <div class="form-check radios">
              <input type="radio" class="form-check-input" id="teacherRole" name="user" value="teacher">
              <label class="form-check-label" for="teacherRole">Teacher</label>
            </div> 
            <br> 
            <div class="col-12">
              <label for="nstudent" class="form-label">Number Student</label>
              <input type="text" class="form-control" id="nstudent" name="id_student" placeholder="119***35">
              
            </div>
              <br>
              <div class="col-12" style="display: none;">
                <label for="cvdoctor" class="form-label">CV doctor</label>               
                <textarea type="textarea" class="form-control" name="cv_doc" id="cvdoctor" maxlength="200" placeholder="talk about yuorself in maximum 200 charcrahcter"></textarea>
                  </div>

          <hr class="my-4">       
         







          
          <div class="col-12">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" placeholder="123-abc-789">
            <div class="invalid-feedback">
              Please enter password(at last 8 charcrahcter ).
            </div>
            <br>
          </div>
          <div class="col-12">
            <label for="password" class="form-label">Commfort Password </label>
            <input type="password" class="form-control" id="cpassword" name="cpassword" placeholder="123-abc-789">
            <div class="invalid-feedback">
               password not same 
            </div>
          </div>

          <br>       



          

          <button class="w-100 btn btn-primary btn-lg" id="sing-up"  name="sing-up">sing up</button>
        </form>
      </div>

<br>
      <script src="js/sing-up.js"></script>
      <div class="bottom-right-button" style="position: static; text-align:center;">
        <a href="/"><button type="button" class="btn btn-outline-primary me-2">home</button></a>
        <a href="/sing-in"><button type="button" class="btn btn-primary">Login</button></a>
    </div>
</section>

















<meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
