
<!DOCTYPE html>
<head>
    <section id="titel" class="gradient-background" style="position: relative;">
        <div style="display:flex; align-items: center;">
            <img src="img/t4-1-128.png" alt="icon-square" width="50px" height="55px">
            <h1 style=" margin-left: 10px;">T4Student<br></h1>   
</div>  
    
       
    </section>
</head>

<body>
    <main class="form-signin w-100 m-auto">
      <form action="/verify" method="POST">
        
        <h1 class="h3 mb-3 fw-normal" style="text-align: center; font-size: 30px;font: bolder;">Please Enter code verfiy</h1>
        <% if (locals.valid) { %>
          <p style="color: red; text-align: center;">
            <%= valid %>
          </p>
          <% } %>
        <br>
        <div class="form-floating">
            <input type="code" class="form-control" id="code" name="code"  required>
            <label for="code">Enter Code verfiy</label>
        </div><br>
        
       
        <button type="verfiy" class="btn btn-primary w-100 py-2">verfiy</button>
        <p class="mt-5 mb-3 text-body-secondary">©2024</p>
    </form>
    
        
      </main>
    
     
</body>









