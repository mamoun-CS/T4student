<!DOCTYPE html>
<head>
    <section id="titel" class="gradient-background" style="position: relative;">
        <div style="display:flex; align-items: center;">
            <img src="img/t4-1-128.png" alt="icon-square" width="50px" height="55px">
            <h1 style=" margin-left: 10px;">T4Student<br></h1>   
</div>  
    
       
    </section>
</head>

<body>
    <main class="form-signin w-100 m-auto">
      <%if (locals.load == 0 ) { %>
      <form action="/change-password" method="POST">
        
        <h1 class="h3 mb-3 fw-normal" style="text-align: center; font-size: 30px;font: bolder;">change Password</h1>
        <% if (locals.valid) { %>
          <p style="color: red; text-align: center;">
            <%= valid %>
          </p>
          <% } else { %>
            <p style="color:black; text-align: center;"></p>
            <% } %>
        <br>

        <div class="form-floating">
            <input type="password" class="form-control" id="passwordpre" name="password" placeholder="name@example.com" required>
            <label for="password">previous password</label>
        </div><br>
        <div class="form-floating">
            <input type="password" class="form-control" id="passwordnew" name="password" placeholder="Password" required>
            <label for="password">New Password</label>
        </div>
        <br>
        <div class="form-floating">
            <input type="password" class="form-control" id="passwordnew2" name="password" placeholder="Password" required>
            <label for="password">New Password</label>
        </div>
     <%} else { %>
      <form action="/change-passwordr" method="POST">
        <h1 class="h3 mb-3 fw-normal" style="text-align: center; font-size: 30px;font: bolder;">change Password</h1>
        <% if (locals.valid) { %>
          <p style="color: red; text-align: center;">
            <%= valid %>
          </p>
          <% } else { %>
            <p style="color:black; text-align: center;"></p>
            <% } %>
        <br>
      <div class="form-floating">
        <input type="password" class="form-control" id="passwordnew" name="password" placeholder="Password" required>
        <label for="password">New Password</label>
    </div>
    <br>
    <div class="form-floating">
        <input type="password" class="form-control" id="passwordnew2" name="password" placeholder="Password" required>
        <label for="password">New Password</label>
    </div>
         <% } %>
        <br>
        <button type="submit" class="btn btn-primary w-100 py-2">Enter Change</button>
        <p class="mt-5 mb-3 text-body-secondary">©2024</p>
        <a href="/"><button type="button" class="btn btn-outline-primary me-2">home</button></a>
        <a href="/sing-in"><button type="button" class="btn btn-primary">sing in</button></a>
  
    </form>
    
        
      </main>
    
     
</body>









