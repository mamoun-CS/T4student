<!DOCTYPE html>
<head>

  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>T4Student-createquiz</title>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
  />
 
  <div class="gradient-background">
    <section id="titel" class="gradient-background" style="position:static;">
        <div style="display:flex; align-items: center;">
            
            <img src="img/t4-1-128.png" alt="icon-square" width="50px" height="55px">
            <h1 style=" margin-left: 10px;">T4Student<br></h1>  
                                               
              <a id="menu-icon" class="menu-icon" onclick="onMenuClick()">
                <i class="fa fa-bars"></i>
              </a>
        
             <div id="navigation-bar" class="nav-bar">               
                    <a href="/editquiz-tec">Edit Quiz</a>
                    <a href="/createquiz-tec">Create Quiz</a>  
                    <a href="/about-quiz">about Quizes</a>             
                    <a href="/" id="singout" >sing out </a>
              </div>   
        
       
              
        </div>

    </section>
    <script src="js/page1-1.js"></script>
    <script src="js/sing-out.js"></script>

    

    </div>
    
</head>

<body>
  <div class="page-content page-container" id="page-content">
    <div class="padding">
        <div class="row container d-flex justify-content-center">
<div class="col-xl-9 col-md-12">
   <div class="card user-card-full">
      <div class="row m-l-0 m-r-0">
        <div class="col-sm-4 bg-c-lite-green user-profile">
           <div class="card-block text-center text-white">
             <div class="m-b-25">
              <img src="img/teacher (1).png" width="120px" height="120px"  class="img-radius" alt="school-director" class="img-radius" style="background-color:whitesmoke ; border-radius: 50%; box-shadow: 0 5px 8px rgba(0, 0, 0, 0.5);" >
              </div>
              
              <% if (locals.NAME && locals.EmailNAME){%>
           <h6 class="f-w-600" style="font-size: 2vh;"><%=locals.NAME%></h6>
               <p style="font-size: 3vh;">Teacher</p>
           <i class=" mdi mdi-square-edit-outline feather icon-edit m-t-10 f-16"></i>
             </div>
            </div>
        <div class="col-sm-8">
         <div class="card-block">
       <h6 class="m-b-20 p-b-5 b-b-default f-w-600">Information</h6>
         <div class="row">
         <div class="col-sm-6">
           <p class="m-b-10 f-w-600">Email</p>
           <h6 class="text-muted f-w-400"><%= locals.EmailNAME%></h6>
         </div><%}%>
        <div class="col-sm-6">
          <a class="btn btn-primary"  href="/change-password" >change password</a><br>
         </div>
         </div>
          <h6 class="m-b-20 m-t-40 p-b-5 b-b-default f-w-600"></h6>
           <div class="row">
            <div class="col-sm-5">
            <p class="m-b-10 f-w-600">Number of Created Quiz</p>
             <h6 class="text-muted f-w-400" style="text-align: center;font-size: 5vh;"><%=locals.count%></h6>
             </div>
            <div class="col-sm-6">
            <p class="m-b-10 f-w-600">Number of student taken the Quiz</p>
             <div>
              <h6 class="text-muted f-w-400" style="text-align: center;font-size: 5vh;" value="<%=locals.avg%>"><%=locals.avg%></h6>
             </div>
             </div>
            </div>
          <ul class="social-link list-unstyled m-t-40 m-b-10">
       <li><a href="#!" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="facebook" data-abc="true"><i class="mdi mdi-facebook feather icon-facebook facebook" aria-hidden="true"></i></a></li>
       <li><a href="#!" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="twitter" data-abc="true"><i class="mdi mdi-twitter feather icon-twitter twitter" aria-hidden="true"></i></a></li>
       <li><a href="#!" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="instagram" data-abc="true"><i class="mdi mdi-instagram feather icon-instagram instagram" aria-hidden="true"></i></a></li>
          </ul>
              </div>
               </div>
                </div>
                   </div>
                      </div>
                          </div>
                             </div>
                                 </div>
</body>


