<!DOCTYPE html>
<head>

  
  <title>T4Student-createquiz</title>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
  />
  <div class="gradient-background">
    <section id="titel" class="gradient-background" style="position:static;">
        <div style="display:flex; align-items: center;">
            
            <img src="img/t4-1-128.png" alt="icon-square" width="50px" height="55px">
            <h1 style=" margin-left: 10px; ">T4Student<br></h1>  
                                               
              <a id="menu-icon" class="menu-icon" onclick="onMenuClick()">
                <i class="fa fa-bars"></i>
              </a>
        
              <div id="navigation-bar" class="nav-bar">               
                <a href="/profile-tec">profile</a>
                    <a href="/editquiz-tec">Edit Quiz</a>    
                    <a href="/about-quiz">about Quizes</a>         
                    <a href="/" id="singout" >sing out </a>
              </div>   
        
       
              
        </div>

    </section>
    <script src="js/page1-1.js"></script>
    <script src="js/sing-out.js"></script>

    </div>
    
</head>

<body>

  <main class="form-page w-100 m-auto">
      <form action="/createquiz-tec" method="POST">
        <div style="display: flex; gap: 10px; text-align: center;"> 
        <h1 class="h3 mb-3 fw-normal" style=" font-size: 30px;font: bolder; margin-left: 10px; font-style:oblique;">Create Quiz</h1>
        <img src="img/create.svg" alt="Quiz" width="50px" height="50px">
        </div>
    <br>
        
        <div class="form-floating">
          <input type="name" class="form-control" id="major" name="major" placeholder="Name major" required>
          <label for="namemajor">major</label>
        </div><br>
              <div class="form-floating">
            <input type="text" class="form-control" id="course" name="course" placeholder="namecourse" required>
            <label for="text">Course</label>
          </div><br>
          <label for="">Type Quiz</label>
        <br>
        <div class="form-check radios">
          <input type="radio" class="form-check-input" id="midterm" name="quizType" value="Midterm" checked >
          <label class="form-check-label" for="Midterm">Midterm</label>
        </div> 
        <div class="form-check radios">
          <input type="radio" class="form-check-input" id="final" name="quizType" value="final" >
          <label class="form-check-label" for="final">Final</label>
        </div> 
        <br> 
        
       



        <br><hr>


                          
        <button type="submit" class="btn btn-primary w-100 py-2" >GO TO Create</button>
    
        <p class="mt-50 mb-3 text-body-secondary">©2024</p>
      </form>
      
    </main>
  
   
</body>




