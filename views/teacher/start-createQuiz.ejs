<!DOCTYPE html>
<html>
<head>

     <title>T4Student-Screatequiz</title>
     <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
     />
   
  
</head>

<body>

    <section>
        <div class="gradient-background">
            <section id="titel" class="gradient-background" style="position:static;">
                <div style="display:flex; align-items: center;">
                    
                    <img src="img/t4-1-128.png" alt="icon-square" width="50px" height="55px">
                    <h1 style=" margin-left: 10px;">T4Student<br></h1>  
                                                       
                </div>
            </section>
            </div>
            <div class="layout">
                <a id="menu-icon" class="menu-icon" onclick="onMenuClick()">
                    <i class="fa fa-bars"></i>
                  </a>
                  
                <div class="side-bar sode-bar nav-bar" id="navigation-bar">
                    <div id="Q1" class="start">
                         <h1 class="nums" >QS</h1>
        
                    </div>
                    <br>
                    <div class="start" id="Q+">
                             <h1 class="nums">+Q</h1>
                    </div>
                    <br>
                    <div id="baraddqustion" class="sode-bar">
                        
                         <div class="start" style="display: none;">
                                 <h1 id="num"></h1>
                                 <h1 class='num'>Q1</h1>
                         </div>
                      
                    </div>
                    <br>
                    
                    <div class="viwedisaply bottom-right-button" >
                        <a href="#"><button id="submit" type="button" class="btn btn-outline-primary me-2">Submit</button></a>
                    </div>
                   
        

                    <div class=" viwe bottom-right-button" >
                        <a href="#"><button id="submit" type="button" class="btn btn-outline-primary me-2">Submit</button></a>
                    </div>
        
                        
                            
                                
                        <script src="js/submitqustion.js"></script>
                        
                        
                    
                </div>
                
                <div class="main-content">
                
                    <div class="center-squareimg"  id="first-step"style="display: none;" >
                      <h1 style="text-align: center;margin-top: -10px;" class="hh">Add Image Qustion</h1>
                    </div>
                    <div class="center-squareQ1" id="two-step"style="display: none;">
                        <h1 style="text-align: center;margin-top: -10px;" class="hh">Add Write Qustion</h1>
                    </div>
                
                    <!-- this is first code node -->
                    <div id="wquiz" class="main-content" >
                        <main class="form-signin w-100 m-auto">
                            <form>
                                <form action="/submit-quiz" method="POST">
                                    <!-- Question Input -->
                                    <div class="form-floating">
                                        <input type="text" maxlength="20px" class="form-control" id="qustion" name="question"  placeholder="question"required>
                                        <label for="qustion">Enter your question:</label>
                                      </div> <br>
                                    <!-- Multiple Choice Answers -->
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="option1" name="option1"  placeholder="option1" required>
                                         <label for="option1">Option 1:</label>
                                    </div>
                                    <br>
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="option2" name="option2"  placeholder="option2" required>
                                         <label for="option2">Option 2:</label>
                                    </div>
                                     <br>
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="option3" name="option3"  placeholder="option3" value="">
                                         <label for="option3">Option 3:</label>
                                    </div>
                                    <br>
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="option4" name="option4"  placeholder="option4" value="">
                                         <label for="option4">Option 4:</label>
                                    </div>
                                    
                                    <!-- Select Correct Answer -->
                                    <div>
                                        <label for="correct-answer">Choose the correct answer:</label>
                                        <select id="correct-answer" name="correct-answer" required>
                                            <option value="1">Option 1</option>
                                            <option value="2">Option 2</option>
                                            <option value="3">Option 3</option>
                                            <option value="4">Option 4</option>
                                        </select>
                                    </div>
                            
                                    <!-- Submit Button -->
                                     <br>
                                    <div>
                                        <button class="btn btn-primary w-100 py-3" type="submit"> Next</button>
                                    </div>
                                </form>
                          
                         
                             <div class="bottom-right-button" style="position: static; bottom: 20px; right: 20px;">
                              
                        </div>
                        
                            </form>
                            
                          </main>
        
                    </div>
                

                </div>
                
            </div>
        

<script src="js/add-writeQ.js"></script>
</body>










