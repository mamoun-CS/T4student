      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
   
    <div class="gradient-background">
      <section id="titel" class="gradient-background" style="position:static;">
          <div style="display:flex; align-items: center;">
              
              <img src="img/t4-1-128.png" alt="icon-square" width="50px" height="55px">
              <h1 style=" margin-left: 10px;">T4Student<br></h1>  
                                                 
                <a id="menu-icon" class="menu-icon" onclick="onMenuClick()">
                  <i class="fa fa-bars"></i>
                </a>
          
                <div id="navigation-bar" class="nav-bar">               
                  <a href="/page1quiz-stu">Quiz</a>       
                  <a href="/page1Serach-stu">Search</a>
                  <a href="/profile-stu">Profile</a>  
                  <a href="/" id="singout" >sing out</a>              
                </div>    
          
         
                
          </div>
  
      </section>
      <script src="js/page1-1.js"></script>
      <script src="js/sing-out.js"></script>
  
      </div>
      
  </head>

  <body>

    <main class="form-signin w-100 m-auto">
      <form id="AI-Assist-Form" action="/AI-Assist" method="POST" >
        <div id="progress"></div>
        <% for (let i=0 ; i<data_Ai.length ; i++) { %>
          <div id="response<%=i%>" value="Q<%=i%>"></div>
          <% } %><hr><br>    
        <% if (locals.avg >= 60 && locals.avg != 100) { %>
        <% if (locals.id_q == locals.sec) { %>   
          <button id="AI-Assist" type="submit" value="<%=locals.wait%>">AI-Assist</button>
         <% } else { %>
          <h1 style="text-align: center;">Wait until time is up to try again.</h1>
          <h1 id="timer" style="text-align: center;"></h1>
          <% } %>
          <%}else if (locals.avg == 100){%>
            <h1 style="text-align: center;"> You don't need help. </h1>
         <%} else {%>
          <h1 style="text-align: center;">restudy material </h1>
          <%}%>
        <script>
         let data3 = []; 
          let round =0; 
         let time = <%=locals.time%> ;
         
         window.onload = () => startTimer();
          document.addEventListener("DOMContentLoaded", () => {
          const { jsPDF } = window.jspdf;
           
           let t=0 ;
           let r1=[];
      
           const AIForm = document.getElementById("AI-Assist-Form");
           AIForm.addEventListener('submit',async (e)  => {
           e.preventDefault();

           const AIButton = document.getElementById("AI-Assist");
           round = AIButton.value||0 ; 
  
           if (round == 1  )
           {  
           alert(1);
              data3 =await load();
              const pdf = new jsPDF();
              data3.forEach((text, index) => {
  
              pdf.setFontSize(14);
              pdf.text(`Question ${index + 1}`, 10, 20); 


             pdf.setFontSize(12);
             const pageWidth = pdf.internal.pageSize.width - 20; 
             const lines = pdf.splitTextToSize(text, pageWidth); 
             let cursorY = 30;

             lines.forEach((line) => {
               if (cursorY > pdf.internal.pageSize.height - 20) {
                 pdf.addPage();
                 cursorY = 20; 
               }
               pdf.text(line, 10, cursorY);
               cursorY += 10;
             });

             if (index < data3.length - 1) pdf.addPage(); 
            });
            pdf.save("examforyou.pdf");
            }
           else {
              // Prevent default form submission
              AIButton.value = 1 ;
            const data_Ai = <%- JSON.stringify(data_Ai) %>; // Pass the data_Ai array to the script
            await processImagesSequentially(data_Ai);  

          }
           });
          });
         
      
        </script>
        <script src="js/process-image.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/tesseract.js@4.0.3/dist/tesseract.min.js"></script>
        
      </main>
    
     
</body>









